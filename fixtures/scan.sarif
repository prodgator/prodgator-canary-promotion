            { "id": "PROMO002", "name": "SyntheticNoteTwo", "shortDescription": { "text": "Promotion canary fixture: SyntheticNoteTwo" }, "defaultConfiguration": { "level": "note" }, "properties": { "security-severity": "1.5" } }
